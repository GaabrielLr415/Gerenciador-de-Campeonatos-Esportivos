{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Campeonato",
      "type": "shell",
      "command": "gcc",
      "args": [
        "-std=c11",
        "-Wall",
        "-Wextra",
        "-O2",
        "main.c",
        "campeonato.c",
        "jogadores.c",
        "classificacao.c",
        "listagem.c",
        "-o",
        "campeonato.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile",
      "detail": "Compila o projeto em campeonato.exe"
    },
    {
      "label": "Run Campeonato",
      "type": "shell",
      "command": "campeonato.exe",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "Build Campeonato"
      ],
      "problemMatcher": [],
      "detail": "Executa o programa compilado"
    }
  ]
}
